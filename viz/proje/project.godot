; İDA görselleştirici (W3-viz). Godot 4.7.2, Forward+.
; Proje ayarları sürümlenir (07 §2.10): çizici, dikey eşzamanlama, max_fps, düşük işlemci kipi
; kapalı, Godot fizik düğümü yok.

config_version=5

[application]

config/name="IDA Gorsellestirici"
config/description="İDA operatör 3B görünümü: A2 istemcisi (GDExtension) ve sahne."
run/main_scene="res://ana.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false
run/max_fps=120

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.08, 0.12, 1)
