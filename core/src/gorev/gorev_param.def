/*
 * gorev_param.def — görev, kip ve arıza güvenliği parametreleri. Sahibi: W3 güdüm ve görev
 * işi. Kimlik bloğu 0x04xx. Satır biçimi cerceve/cerceve_param.def başındadır.
 *
 * A4-K52 (yer istasyonu kaybının süreleri) ve A4-K76 (batarya ve sızıntı eşikleri, arıza
 * eylemleri) bunları çekirdek parametresi yapar. Süreler duvar saatinde ms (IDA_PT_U32;
 * ns'ye int64_t'de çevrilir, zaman/zaman.h ida_ms_ns). Bütün varsayılanlar TAHMİNDİR
 * (02 §4.1, §4.3; İDA-0 4S paketi için 04 §2.7: 12 V asgari güvenli); ölçülmedi.
 * Hepsi B sınıfıdır (yalnız silahsızken): arıza eşikleri emniyete girer.
 * Grup koşulları (ida_gor_param_grup): BATT_KRIT_V < BATT_DUSUK_V; GCS_KAYIP_MS < GCS_KAYIP2_MS.
 */
IDA_PARAM(0x0401u, GCS_KAYIP_MS,     U32, B, 500u,   30000u,   3000u,   gor_gcs1_ms)        /* A4-K52; 02 §4.3 (3 s) */
IDA_PARAM(0x0402u, GCS_KAYIP2_MS,    U32, B, 1000u,  600000u,  60000u,  gor_gcs2_ms)        /* A4-K52; 02 §4.3 (60 s) */
IDA_PARAM(0x0403u, SIZINTI_N,        U32, B, 1u,     20u,      2u,      gor_sizinti_n)      /* A4-K76; ardışık ıslak örnek */
IDA_PARAM(0x0404u, SIZINTI_BAYAT_MS, U32, B, 200u,   10000u,   2000u,   gor_sizinti_bayat_ms) /* 02 §4.1 */
IDA_PARAM(0x0405u, BATT_DUSUK_V,     F32, B, 0.0f,   60.0f,    13.2f,   gor_batt_dusuk_v)   /* A4-K76 */
IDA_PARAM(0x0406u, BATT_KRIT_V,      F32, B, 0.0f,   60.0f,    12.4f,   gor_batt_krit_v)    /* A4-K76; ≥ 12 V (04 §2.7) */
IDA_PARAM(0x0407u, BATT_HIST_V,      F32, B, 0.0f,   5.0f,     0.3f,    gor_batt_hist_v)    /* temizleme histerezisi */
IDA_PARAM(0x0408u, BATT_SURE_MS,     U32, B, 1000u,  60000u,   10000u,  gor_batt_sure_ms)   /* 02 §4.3 (10 s) */
IDA_PARAM(0x0409u, BATT_KRIT2_MS,    U32, B, 1000u,  600000u,  60000u,  gor_batt_krit2_ms)  /* 02 §4.3 (60 s) */
IDA_PARAM(0x040Au, BATT_BAYAT_MS,    U32, B, 200u,   10000u,   2000u,   gor_batt_bayat_ms)  /* 02 §4.1 */
IDA_PARAM(0x040Bu, EST_KOTU_MS,      U32, B, 100u,   10000u,   2000u,   gor_est_kotu_ms)    /* 02 §4.3 (2 s) */
IDA_PARAM(0x040Cu, EST_BOZUK_MS,     U32, B, 1000u,  300000u,  30000u,  gor_est_bozuk_ms)   /* 02 §4.3 (30 s) */
IDA_PARAM(0x040Du, EST_OK_MS,        U32, B, 100u,   10000u,   2000u,   gor_est_ok_ms)      /* 02 §4.3 (2 s) */
IDA_PARAM(0x040Eu, IMU_TAZE_MS,      U32, B, 100u,   10000u,   1000u,   gor_imu_taze_ms)    /* 02 §4.3 (1 s) */
IDA_PARAM(0x040Fu, YUZEY_D,          F32, B, 0.0f,   2.0f,     0.3f,    gor_yuzey_d)        /* m; yüzey eşiği */
IDA_PARAM(0x0410u, YUKSELME_HIZI,    F32, B, 0.05f,  1.0f,     0.25f,   gor_yukselme_hizi)  /* m/s; 02 §2.4 v_asc */
/* W5-gorev-yurutucu (02 §2.6, §4.3; W5-K24). Varsayılanlar TAHMİNDİR, ölçülmedi. */
IDA_PARAM(0x0411u, GEO_YARICAP,      F32, B, 5.0f,   20000.0f, 1000.0f, gor_geo_yaricap)    /* m; orijinden yatay yarıçap */
IDA_PARAM(0x0412u, GOREV_AZAMI_S,    U32, B, 60u,    86400u,   7200u,   gor_gorev_azami_s)  /* s; toplam görev süresi (duvar) */
IDA_PARAM(0x0413u, ALT_MIN,          F32, B, 0.0f,   20.0f,    0.3f,    gor_alt_min)        /* m; en az irtifa (0: kapalı) */
IDA_PARAM(0x0414u, DR_YOL_MAX,       F32, B, 10.0f,  5000.0f,  200.0f,  gor_dr_yol_max)     /* m; GNSS'siz yol (W5-K24) */
IDA_PARAM(0x0415u, DR_BEKLE_S,       U32, B, 10u,    3600u,    300u,    gor_dr_bekle_s)     /* s; yüzeyde GNSS beklemesi */
IDA_PARAM(0x0416u, ASIM_KAT,         F32, B, 1.0f,   10.0f,    2.0f,    gor_asim_kat)       /* öğe zaman aşımı katsayısı */
IDA_PARAM(0x0417u, ASIM_PAY_S,       U32, B, 0u,     3600u,    60u,     gor_asim_pay_s)     /* s; öğe zaman aşımı payı */
IDA_PARAM(0x0418u, BANT_MS,          U32, B, 0u,     60000u,   1000u,   gor_bant_ms)        /* ms; DIVE_TO bantta kalma (ölçüm zamanı) */
