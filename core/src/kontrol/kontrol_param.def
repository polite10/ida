/* ---- İtki modeli ve eğrinin tersi (04 §2.7.2; A5-K104; A4-K54) --------------------------- */
IDA_PARAM(0x0531u, THR_FMAX_FWD, F32, B, 1.0f, 1000.0f, 49.94f, kon_fmax_ileri)   /* N, TAHMİN */
IDA_PARAM(0x0532u, THR_FMAX_REV, F32, B, 1.0f, 1000.0f, 39.02f, kon_fmax_geri)    /* N, TAHMİN */
