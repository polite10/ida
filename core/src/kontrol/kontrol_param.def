IDA_PARAM(0x051Fu, T6_RX, F32, B, -2.0f, 2.0f, 0.12f, kon_t6_rx)
IDA_PARAM(0x0520u, T6_RY, F32, B, -2.0f, 2.0f, -0.218f, kon_t6_ry)
