/* ---- İtici durumu ve çıkış değişim hızı -------------------------------------------------- */
IDA_PARAM(0x0539u, THR_OFF_MASK, U32, A, 0u, 255u, 0u, kon_itici_disi)  /* bit i: t(i+1) devre dışı */
IDA_PARAM(0x053Au, THR_SLEW, F32, A, 1.0f, 100000.0f, 250.0f, kon_itki_egim) /* N/s, itici başına */
/* ---- Çıkış sınırları (genelleştirilmiş kuvvet ve setpoint) ------------------------------- */
IDA_PARAM(0x0540u, LIM_FXY, F32, A, 0.0f, 1000.0f, 40.0f, kon_lim_fxy)   /* N, X ve Y ayrı ayrı */
IDA_PARAM(0x0541u, LIM_FZ, F32, A, 0.0f, 1000.0f, 80.0f, kon_lim_fz)     /* N */
IDA_PARAM(0x0542u, LIM_MKM, F32, A, 0.0f, 100.0f, 10.0f, kon_lim_mkm)    /* N·m, K ve M */
IDA_PARAM(0x0543u, LIM_MN, F32, A, 0.0f, 100.0f, 10.0f, kon_lim_mn)      /* N·m */
IDA_PARAM(0x0544u, LIM_W, F32, A, 0.0f, 5.0f, 0.5f, kon_lim_w)           /* m/s, dikey hız setpoint'i */
IDA_PARAM(0x0545u, LIM_V, F32, A, 0.0f, 5.0f, 1.0f, kon_lim_v)           /* m/s, yatay hız setpoint'i */
IDA_PARAM(0x0546u, LIM_PQ, F32, A, 0.0f, 5.0f, 0.8f, kon_lim_pq)         /* rad/s */
IDA_PARAM(0x0547u, LIM_R, F32, A, 0.0f, 5.0f, 0.6f, kon_lim_r)           /* rad/s */
/* ---- Basamak yumuşatma (referans değişim hızı) ------------------------------------------- */
IDA_PARAM(0x0548u, REF_DEP_RATE, F32, A, 0.01f, 5.0f, 0.25f, kon_ref_derinlik_hizi) /* m/s */
IDA_PARAM(0x0549u, REF_YAW_RATE, F32, A, 0.01f, 5.0f, 0.35f, kon_ref_yon_hizi)      /* rad/s */
/* ---- Kazançlar --------------------------------------------------------------------------- */
IDA_PARAM(0x0550u, DEP_KP, F32, A, 0.0f, 20.0f, 0.8f, kon_derinlik_kp)     /* 1/s: derinlik → w_sp */
IDA_PARAM(0x0551u, W_KP, F32, A, 0.0f, 1000.0f, 120.0f, kon_w_kp)          /* N·s/m; Z1'de ayarlandı */
IDA_PARAM(0x0552u, W_KI, F32, A, 0.0f, 1000.0f, 15.0f, kon_w_ki)           /* N/m; Z1'de ayarlandı */
IDA_PARAM(0x0553u, BUOY_FF, F32, A, -50.0f, 50.0f, 1.82f, kon_yuzerlik_ff) /* N, NED aşağı; B − W */
IDA_PARAM(0x0554u, ATT_KP_RP, F32, A, 0.0f, 50.0f, 2.0f, kon_tutum_kp)     /* 1/s: yalpa, baş-kıç */
IDA_PARAM(0x0555u, ATT_KP_Y, F32, A, 0.0f, 50.0f, 3.0f, kon_yon_kp)        /* 1/s: yön; Z1'de ayarlandı */
IDA_PARAM(0x0556u, RATE_KP_PQ, F32, A, 0.0f, 100.0f, 3.0f, kon_pq_kp)      /* N·m·s/rad */
IDA_PARAM(0x0557u, RATE_KI_PQ, F32, A, 0.0f, 100.0f, 3.0f, kon_pq_ki)      /* N·m/rad */
IDA_PARAM(0x0558u, RATE_KP_R, F32, A, 0.0f, 100.0f, 8.0f, kon_r_kp)        /* N·m·s/rad; Z1'de ayarlandı */
IDA_PARAM(0x0559u, RATE_KI_R, F32, A, 0.0f, 100.0f, 4.0f, kon_r_ki)        /* N·m/rad */
IDA_PARAM(0x055Au, VEL_KP, F32, A, 0.0f, 1000.0f, 40.0f, kon_v_kp)         /* N·s/m */
IDA_PARAM(0x055Bu, VEL_KI, F32, A, 0.0f, 1000.0f, 10.0f, kon_v_ki)         /* N/m */
/* Sönüm ileri beslemesi (02 §2.5): setpoint hızı × katsayı. W_DAMP_FF: İDA-0'ın dikey sönümünün
   derinlik referansı hızındaki (REF_DEP_RATE = 0,25 m/s) kirişi: (33·0,25 + 190·0,25²) / 0,25
   ≈ 80 N·s/m (ida0.toml doğrusal ve karesel sönüm); V_DAMP_FF TAHMİN. */
IDA_PARAM(0x055Cu, W_DAMP_FF, F32, A, 0.0f, 1000.0f, 80.0f, kon_w_sonum)   /* N·s/m; Z1'de ayarlandı */
IDA_PARAM(0x055Du, V_DAMP_FF, F32, A, 0.0f, 1000.0f, 20.0f, kon_v_sonum)   /* N·s/m */
